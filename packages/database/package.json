{
  "name": "@lead-agent/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --declaration true --declarationMap true --outDir dist --rootDir src",
    "db:check": "drizzle-kit check --config=drizzle.config.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10"
  }
}
