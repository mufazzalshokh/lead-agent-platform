# API process settings used by apps/api.
HOST=127.0.0.1
PORT=3001

# S6.6 staff browser authentication. Values below are non-secret placeholders.
APP_ENV=development
AUTH0_ISSUER=https://example-development.auth0.com/
AUTH0_CLIENT_ID=replace-with-development-client-id
AUTH0_CLIENT_SECRET=replace-with-secret-manager-reference
AUTH0_CALLBACK_URI=http://localhost:3001/v1/staff/auth/callback
STAFF_APPLICATION_ORIGIN=http://localhost:3000
STAFF_ALLOWED_ORIGINS=http://localhost:3000
AUTH_PRODUCTION_MFA_REQUIRED=false
AUTH_BROWSER_ENVELOPE_KEY=replace-with-32-byte-base64url-secret
INVITATION_TARGET_ENCRYPTION_KEY=replace-with-distinct-32-byte-base64url-secret
INVITATION_TARGET_LOOKUP_KEY=replace-with-distinct-32-byte-base64url-secret
# S9 customer data protection. All three values are secret-manager supplied.
CUSTOMER_DATA_ENCRYPTION_KEY_ID=customer-data-v1
CUSTOMER_DATA_ENCRYPTION_KEY=replace-with-distinct-32-byte-base64url-secret
CUSTOMER_DATA_LOOKUP_KEY=replace-with-distinct-32-byte-base64url-secret
# S10 Widget JWT signing. Must be distinct from every key above.
WIDGET_SIGNING_KEY=replace-with-distinct-32-byte-base64url-secret
# S11 shared platform Telegram Business bot. Supply all secrets from a secret manager.
TELEGRAM_BOT_TOKEN=123456789:replace-with-platform-bot-token
TELEGRAM_BOT_USERNAME=replace_with_platform_bot_username
TELEGRAM_WEBHOOK_SECRET=replace-with-43-byte-base64url-webhook-secret
TELEGRAM_WEBHOOK_URL=https://api.example.com/v1/webhooks/telegram
# Narrow lead_agent_ingress role used only for pre-tenant route resolution.
INGRESS_DATABASE_URL=postgresql://lead_agent_ingress:replace@localhost:5432/lead_agent_local
AUTH_DATABASE_URL=postgresql://lead_agent_auth:replace@localhost:5432/lead_agent_local
DATABASE_URL=postgresql://lead_agent_runtime:replace@localhost:5432/lead_agent_local
# S11 Instagram Login platform app. Empty placeholders; secrets come from a managed store.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_OAUTH_REDIRECT_URI=https://api.example.com/v1/integrations/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v25.0
# S13 owner-approved, paid-tier Gemini. Empty key disables the proposal-only handler.
# Account billing/data controls must be verified by deployment operations.
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_REQUEST_TIMEOUT_MS=15000
# Non-default OpenAI adapter infrastructure only; never an automatic worker fallback.
OPENAI_API_KEY=
